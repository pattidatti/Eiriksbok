{
    "rules": {
        "analytics": {
            "views": {
                ".read": true,
                "$id": {
                    ".write": true
                }
            },
            "active_users": {
                ".read": true,
                "$id": {
                    ".write": true
                }
            },
            "unique_users": {
                ".read": true,
                "$id": {
                    ".write": "data.exists() || !data.exists()"
                }
            },
            "reading_time": {
                ".read": true,
                "$sti": {
                    "$maling": {
                        ".write": "!data.exists() && newData.exists()",
                        ".validate": "newData.hasChildren(['duration', 'timestamp', 'path']) && newData.child('duration').isNumber() && newData.child('duration').val() > 5000 && newData.child('duration').val() < 14400000 && newData.child('path').isString() && newData.child('path').val().length <= 300"
                    }
                }
            },
            "searches": {
                "$sok": {
                    ".write": "!data.exists() && newData.exists()",
                    ".validate": "newData.hasChildren(['query', 'timestamp']) && newData.child('query').isString() && newData.child('query').val().length <= 200"
                }
            },
            "games": {
                "hangman": {
                    ".read": true,
                    "$runde": {
                        ".write": "!data.exists() && newData.exists()",
                        ".validate": "newData.hasChildren(['outcome', 'timestamp']) && newData.child('outcome').isString() && newData.child('outcome').val().matches(/^(won|lost)$/)"
                    }
                }
            }
        },
        "feedback": {
            "$feedbackId": {
                ".write": "!data.exists() && newData.exists()",
                ".validate": "newData.hasChildren(['message', 'timestamp']) && newData.child('message').isString() && newData.child('message').val().length < 5000"
            }
        },
        "rooms": {
            ".read": true,
            ".write": true
        },
        "quiz-data": {
            ".read": true,
            ".write": true
        },
        "compositions": {
            ".read": true,
            ".write": true
        },
        "presence": {
            ".read": true,
            ".write": true
        },
        "rpg-hub": {
            "rom": {
                ".read": true,
                "$rom": {
                    "$klient": {
                        ".write": true,
                        "navn": {
                            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16 && newData.val().matches(/^[a-zA-ZæøåÆØÅéèêüöäáàâç][a-zA-ZæøåÆØÅéèêüöäáàâç -]*$/)"
                        },
                        "x": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8192"
                        },
                        "y": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8192"
                        },
                        "dir": {
                            ".validate": "newData.isString() && newData.val().matches(/^(ned|opp|venstre|hoyre)$/)"
                        },
                        "positur": {
                            ".validate": "newData.isString() && newData.val().matches(/^(idle|gang)$/)"
                        },
                        "sitter": { ".validate": "newData.isBoolean()" },
                        "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
                        "classId": {
                            ".validate": "newData.isString() && newData.val().matches(/^(skald|runemester|vokter)$/)"
                        },
                        "rustning": {
                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
                        },
                        "sist": { ".validate": "newData.isNumber()" },
                        "appearance": {
                            "$felt": {
                                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32"
                            }
                        },
                        "$annet": { ".validate": false }
                    }
                }
            }
        },
        "progress": {
            "$code": {
                ".read": true,
                ".write": true,
                ".validate": "$code.matches(/^[a-z]+-[a-z]+-[a-z]+$/)"
            }
        },
        ".read": false,
        ".write": false
    }
}
            "replikker": [
                {
                    "si": "Se på stigen nå, med alle ni på plass."
                },
                {
                    "si": "Ytterpunktene er lette å forklare. Men bare to havner helt ute på kanten: kristendommen øverst og buddhismen nederst."
                },
                {
                    "si": "Resten ligger imellom. De er ikke vage. De mener begge deler, med vilje: gjør jobben, men det siste ordet er ikke ditt."
                },
                {
                    "si": "Og bhakti-hinduismen og rent land-buddhismen ligger nærmere nåden enn resten av sin egen religion."
                }
            ]
        },

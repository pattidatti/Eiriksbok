            "replikker": [
                {
                    "si": "Hinduismen havner nest nederst. Det meste er din jobb, men en nådefull gud kan hjelpe."
                },
                {
                    "si": "Buddhismen havner helt nederst, i den andre enden. Ingen kan redde deg utenfra."
                },
                {
                    "si": "Sikhismen viser tydeligst en midt imellom. Du mediterer over Guds navn, hjelper andre og arbeider ærlig, midt i et vanlig liv."
                },
                {
                    "si": "Men selve møtet med Gud kan du ikke få til alene. Det må Gud gi deg. Nåden heter kirpa, og den er det eneste du ikke rår over selv."
                }
            ]
        },
        {
            "id": "nivaer",
            "kapittel": "Tre yngre svar",
            "visual": {
                "type": "FrelseNivaer"
            },
            "replikker": [
                {
                    "si": "Så tre yngre og mindre trossamfunn. Mormonismen og Jehovas vitner kommer fra kristendommen. Bahá'í kommer fra sjia-islam, en av retningene i islam."
                },
                {
                    "si": "Mormonismen svarer ja og nei på én gang. Kirken lærer at alle døde skal stå opp igjen og leve evig, men at de havner på tre ulike nivåer."
                },
                {
                    "si": "Selve oppstandelsen er en gave alle får."
                },
                {
                    "si": "Men skal du helt til topps, dit kirken kaller opphøyelse, må du tro, være døpt, holde budene og gifte deg i tempelet."
                }
            ]
        },

                            "plassert": ["kristendom", "islam", "jodedom", "hinduisme", "buddhisme"]
                        },
                        {
                            "tekst": "Sikhisme: meditasjon, hjelp og ærlig arbeid",
                            "tradisjon": "sikhisme",
                            "plassert": [
                                "kristendom",
                                "islam",
                                "jodedom",
                                "hinduisme",
                                "buddhisme",
                                "sikhisme"
                            ]
                        },
                        {
                            "tekst": "Kirpa: nåden du ikke rår over",
                            "tradisjon": "sikhisme",
                            "plassert": [
                                "kristendom",
                                "islam",
                                "jodedom",
                                "hinduisme",
                                "buddhisme",
                                "sikhisme"
                            ]
                        }
                    ]
                }

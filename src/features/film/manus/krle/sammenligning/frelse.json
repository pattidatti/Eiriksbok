{
    "id": "frelse",
    "tittel": "Frelse: Målet med det hele",
    "kilde": "/krle/sammenligning/frelse",
    "bilde": "/images/sammenligning/frelse-hero.webp",
    "utenforArtikkel": [],
    "scener": [
        {
            "id": "to-svar",
            "kapittel": "To svar",
            "visual": {
                "type": "FrelseToVeier",
                "props": {
                    "modus": "start"
                }
            },
            "replikker": [
                {
                    "si": "En prest sier at det ikke finnes noe du kan gjøre for å bli frelst."
                },
                {
                    "si": "Gaven er allerede gitt. Prøver du å betale for en gave, har du ikke skjønt hva en gave er."
                },
                {
                    "si": "Langt unna sitter en buddhistisk munk helt stille og gjør det stikk motsatte."
                },
                {
                    "si": "Han jobber med seg selv, dag etter dag. Ingen andre kan gjøre den jobben for ham."
                },
                {
                    "si": "Begge er på vei mot noe godt. Men de er uenige om hvem som må gjøre jobben."
                }
            ]
        },
        {
            "id": "tittel",
            "visual": {
                "type": "Tittelkort",
                "props": {
                    "tittel": "FRELSE",
                    "undertittel": "Målet med det hele",
                    "bilde": "/images/sammenligning/frelse-hero.webp",
                    "sporsmal": {
                        "tekst": "Hvem må gjøre jobben?",
                        "fraBeat": 2
                    }
                }
            },
            "replikker": [
                {
                    "si": "Ordet frelse betyr at et menneske slipper fri fra noe som er galt."
                },
                {
                    "si": "Vi skal møte ni religioner og trossamfunn, og stille dem det samme spørsmålet."
                },
                {
                    "si": "Ikke bare hva målet er. Men hvem som må gjøre jobben for å komme dit."
                }
            ]
        },
        {
            "id": "fra-hva",
            "kapittel": "Fri fra hva?",
            "visual": {
                "type": "FrelseToVeier",
                "props": {
                    "modus": "problem"
                }
            },
            "replikker": [
                {
                    "si": "Alle religionene er enige om at noe er galt. Men de er dypt uenige om hva."
                },
                {
                    "si": "Kristne snakker om synd og skyld. Du har gjort noe galt, og du klarer ikke å gjøre det godt igjen selv."
                },
                {
                    "si": "Hinduer og buddhister snakker om å bli født om og om igjen, uten å komme seg ut."
                },
                {
                    "si": "Og noen tradisjoner synes at selve ordet frelse passer dårlig på dem."
                }
            ]
        },
        {
            "id": "stigen",
            "visual": {
                "type": "FrelseStigen",
                "props": {
                    "fokus": [
                        {
                            "tekst": "To ender av samme stige"
                        },
                        {
                            "tekst": "Noen må hente deg",
                            "ende": "topp"
                        },
                        {
                            "tekst": "Du må slippe taket selv",
                            "ende": "bunn"
                        },
                        {
                            "tekst": "Nåde: en gave du ikke har fortjent",
                            "ende": "topp"
                        },
                        {
                            "tekst": "Ni tradisjoner skal plasseres",
                            "venter": true
                        }
                    ]
                }
            },
            "replikker": [
                {
                    "si": "Derfor kan svarene settes på en stige. Øverst står gjort for deg, nederst gjort av deg."
                },
                {
                    "si": "Skal du reddes ut av noe du ikke klarer å fikse selv, må noen andre komme og hente deg."
                },
                {
                    "si": "Skal du ut av et kretsløp du selv holder i gang, må du slippe taket. Den jobben er din."
                },
                {
                    "si": "Det kristne ordet for den øverste enden er nåde. Gud tilgir den skyldige, selv om mennesket ikke har fortjent det."
                },
                {
                    "si": "Nå plasserer vi ni tradisjoner på stigen, én etter én."
                }
            ]
        },
        {
            "id": "kristendom",
            "kapittel": "Gaven, vekten og pakten",
            "visual": {
                "type": "FrelseStigen",
                "props": {
                    "fokus": [
                        {
                            "tekst": "Kristendom",
                            "tradisjon": "kristendom",
                            "plassert": ["kristendom"]
                        },
                        {
                            "tekst": "Paulus: du får den gratis",
                            "tradisjon": "kristendom",
                            "plassert": ["kristendom"]
                        },
                        {
                            "tekst": "Luther og Calvin: troen alene",
                            "tradisjon": "kristendom",
                            "plassert": ["kristendom"]
                        },
                        {
                            "tekst": "Kristne er ikke enige om alt",
                            "tradisjon": "kristendom",
                            "plassert": ["kristendom"]
                        }
                    ]
                }
            },
            "replikker": [
                {
                    "si": "Først kristendommen. Den ligger så høyt mot gave-enden som det går an."
                },
                {
                    "si": "Paulus skrev at du ikke kan jobbe deg til frelse med gode gjerninger. Du får den gratis."
                },
                {
                    "si": "Luther og Calvin gjorde dette enda skarpere. Det er troen alene som teller, og ingenting du selv presterer."
                },
                {
                    "si": "Kristne er ikke enige om alt. Katolikker sier at nåden kommer først, men at mennesket ikke bare sitter stille."
                }
            ]
        },
        {
            "id": "islam",
            "visual": {
                "type": "FrelseVekt"
            },
            "replikker": [
                {
                    "si": "Islam bruker et helt annet bilde: en vekt."
                },
                {
                    "si": "På dommens dag må både hver enkelt og fellesskapet stå til ansvar for Gud."
                },
                {
                    "si": "Koranen sier at det settes opp riktige vektskåler, slik at ingen skal lide den minste urett."
                },
                {
                    "si": "Men vekten er bare halve bildet. Gud kalles også Den barmhjertige."
                },
                {
                    "si": "Koranen sier at Gud ikke tilgir at noen dyrker noe annet ved siden av ham. Men alt annet kan han tilgi, hos den han vil. Regnskapet føres, men Gud har det siste ordet."
                }
            ]
        },
        {
            "id": "jodedom",
            "visual": {
                "type": "Prikkfelt",
                "props": {
                    "figur": "prikk",
                    "steg": [
                        {
                            "fraBeat": 0,
                            "total": 613,
                            "farget": 0,
                            "restFarge": "#cbd5e1",

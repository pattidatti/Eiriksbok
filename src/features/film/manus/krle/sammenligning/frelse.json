            "visual": {
                "type": "FrelseStigen",
                "props": {
                    "fokus": [
                        {
                            "tekst": "Alle ni på stigen",
                            "plassert": "alle"
                        },
                        {
                            "tekst": "Bare to helt ytterst",
                            "plassert": "alle",
                            "ytterst": true
                        },
                        {
                            "tekst": "Midten mener begge deler, med vilje",
                            "plassert": "alle",
                            "midten": true
                        },
                        {
                            "tekst": "Inne i én religion: ulike trinn",
                            "plassert": "alle",
                            "skygger": true
                        }
                    ]
                }

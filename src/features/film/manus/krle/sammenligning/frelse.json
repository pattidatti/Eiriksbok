            "replikker": [
                {
                    "si": "Islam havner på midten av stigen. Arbeidet er nødvendig, men det siste ordet er ikke ditt."
                },
                {
                    "si": "Jødedommen havner lenger ned. Det meste ligger på hva du gjør, men Gud hjelper deg underveis."
                },
                {
                    "si": "Samme stamfar, Abraham. Likevel tre ulike trinn."
                }
            ]
        },
        {
            "id": "samsara",
            "kapittel": "Veier du må gå selv",
            "visual": {
                "type": "FrelseHjulet",
                "props": {
                    "modus": "samsara"
                }
            },
            "replikker": [
                {
                    "si": "I hinduismen, buddhismen og sikhismen er problemet et annet. Her går verden i ring."
                },
                {
                    "si": "Du blir født, du dør, og du blir født på nytt. Om og om igjen. Kretsløpet heter samsara."
                },
                {
                    "si": "Det er dine egne handlinger som holder hjulet i gang. Da hjelper det lite å bli tilgitt."
                },
                {
                    "si": "Målet i hinduismen heter moksha. Det betyr å komme fri fra gjenfødelsen, altså ut av hjulet."
                }
            ]
        },
        {
            "id": "tre-veier",
            "visual": {
                "type": "FrelseHjulet",
                "props": {
                    "modus": "veier"
                }
            },
            "replikker": [
                {
                    "si": "Hinduismen peker på tre veier ut av hjulet."
                },
                {
                    "si": "Den første er handlingens vei. Du gjør det du skal."
                },
                {
                    "si": "Den andre er kunnskapens vei. Du forstår hvordan alt henger sammen."
                },
                {
                    "si": "Den tredje heter bhakti, hengivelsens vei. Der knytter du deg til en gud som er full av nåde."
                },
                {
                    "si": "De to første gjør du selv. Den tredje ligger nærmere nåden. Én religion, flere trinn."
                }
            ]
        },
        {
            "id": "flammen",
            "visual": {
                "type": "FrelseHjulet",
                "props": {
                    "modus": "flamme"
                }
            },
            "replikker": [
                {
                    "si": "Buddhismens mål heter nirvana. Ordet betyr å slukne."
                },
                {
                    "si": "Nirvana er ikke et paradis. Buddha brukte bildet av en flamme som slukner fordi den ikke har mer å brenne på. Da tar all lidelse slutt."
                },
                {
                    "si": "Veien dit går gjennom din egen måte å leve på, meditasjon og forståelse. Ingen slipper deg inn noe sted."
                }
            ]
        },
        {
            "id": "rent-land",
            "visual": {
                "type": "FrelseKart"
            },
            "replikker": [
                {
                    "si": "Men heller ikke buddhister er enige med hverandre."
                },
                {
                    "si": "I rent land-buddhismen, som står sterkt i Kina og Japan, stoler den troende på buddhaen Amitabha i stedet for på seg selv."
                },
                {
                    "si": "Det er omtrent så nær nåde en buddhist kommer."
                }
            ]
        },
        {

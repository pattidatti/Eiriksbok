                        },
                        {
                            "fraBeat": 2,
                            "total": 613,
                            "farget": 613,
                            "farge": "#3b82f6",
                            "tittel": "Gud tok første steg. Resten er din jobb",
                            "fargeEtikett": "bud du må holde selv"
                        }
                    ]
                }
            },
            "replikker": [
                {
                    "si": "Jødedommen faller nesten utenfor spørsmålet. Jødiske lærde har aldri ment at mennesker fødes med synd. Da er det ikke noe å reddes ut av."
                },
                {
                    "si": "Det viktigste er avtalen med Gud og de 613 budene. Altså hvordan du lever akkurat nå."
                },
                {
                    "si": "Ifølge tradisjonen tok Gud det første steget da avtalen ble inngått. Resten av jobben er din."
                }
            ]
        },
        {
            "id": "plassert-abraham",
            "visual": {
                "type": "FrelseStigen",
                "props": {
                    "fokus": [
                        {
                            "tekst": "Islam: nåde og innsats i samme setning",
                            "tradisjon": "islam",
                            "plassert": ["kristendom", "islam"]
                        },
                        {
                            "tekst": "Jødedom: din vei, men det finnes hjelp",

            "replikker": [
                {
                    "si": "Ligger målet utenfor deg, må noen andre slippe deg inn. Da blir nåde et naturlig svar."
                },
                {
                    "si": "Ligger problemet inne i deg selv, må du rydde opp selv. Da blir innsats et naturlig svar."
                },
                {
                    "si": "Og noen tradisjoner, som jødedommen, mener at hele spørsmålet er stilt med feil ord."
                },
                {
                    "si": "Når en religion ikke vil svare, er det lurt å sjekke om spørsmålet var godt nok."
                }

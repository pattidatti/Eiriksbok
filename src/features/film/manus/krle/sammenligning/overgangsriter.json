            "replikker": [
                {
                    "si": "Noen steder i den buddhistiske verden begynner bryllupsdagen hjemme hos brudeparet."
                },
                {
                    "si": "Munkene fra klosteret kommer på besøk. De får mat, og de leser høyt fra hellige tekster."
                },
                {
                    "si": "Så går munkene tilbake til klosteret."
                },
                {
                    "si": "Senere på dagen blir paret gift. Men det er ikke en eneste munk til stede."
                },
                {
                    "si": "Buddhistiske munker gifter ikke bort folk. Men når noen dør, er det munkene som styrer seremonien."

            "replikker": [
                {
                    "si": "Årene før krigen kalles ofte den vakre tiden. Europa var rikt og sterkt. Tenk deg alt landet på jorda som hundre prikker."
                },
                {
                    "si": "De europeiske stormaktene og koloniene deres dekket over 80 prosent av landet på jorda. Kolonier er land som blir styrt av et annet land."
                },
                {
                    "si": "Europa nærmest eide verden. Og folk trodde at framtiden bare ville bli bedre."
                }

            "replikker": [
                {
                    "si": "Hvorfor ble det krig? Historikere diskuterer det fortsatt. Men de fleste peker på flere ting som hadde bygd seg opp i mange år."
                },
                {
                    "si": "Stormaktene konkurrerte om kolonier i Afrika og Asia. Kolonier er land som blir styrt av et annet land. Kampen skapte mistillit og fiendskap."
                },
                {
                    "si": "Mange folk ville ha sitt eget land. Det kalles nasjonalisme. Særlig på Balkan truet det de gamle rikene med mange folkegrupper, som Østerrike-Ungarn."
                },
                {
                    "si": "Stormaktene bygde opp enorme hærer for å være trygge."
                },
                {
                    "si": "Og de lovet å hjelpe hverandre hvis noen ble angrepet. Slike avtaler kalles allianser."
                }

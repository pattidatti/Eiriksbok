            "replikker": [
                {
                    "si": "Krigen ble et møte mellom gammelt og nytt."
                },
                {
                    "si": "I begynnelsen red offiserer til hest, i fargesterke uniformer og med sverd."
                },
                {
                    "si": "Ved slutten ble stridsvogner og fly brukt i stor skala."
                },
                {
                    "si": "Og ubåter, flammekastere og giftgass."
                },
                {
                    "si": "Gammeldags måter å krige på, mot moderne våpen fra fabrikkene. Det var det som gjorde krigen så dødelig."
                }
            ]

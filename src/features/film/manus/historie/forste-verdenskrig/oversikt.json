                    }
                }
            },
            "replikker": [
                {
                    "si": "Folk den gang kalte den Den store krigen. I dag kaller vi den første verdenskrig."
                },
                {
                    "si": "Den varte fra 1914 til 1918. For første gang var land fra alle verdensdeler med i samme krig."
                },
                {
                    "si": "I denne filmen skal vi finne ut hvordan en verden som virket så trygg, kunne falle sammen så fort."
                }
            ]
        },

                    "tittel": "DEN STORE KRIGEN",
                    "undertittel": "Første verdenskrig, 1914-1918",
                    "bilde": "/images/historie/forste-verdenskrig/oversikt_hero.webp",
                    "sporsmal": {
                        "tekst": "Hvordan kunne en trygg verden falle sammen så fort?",

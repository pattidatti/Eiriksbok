            "replikker": [
                {
                    "si": "Så kom gnisten. Sarajevo, 28. juni 1914."
                },
                {
                    "si": "Erkehertug Franz Ferdinand kjører gjennom byen. Han er arving til tronen i Østerrike-Ungarn."
                },
                {
                    "si": "En ung serbisk nasjonalist, Gavrilo Princip, skyter og dreper ham."
                },
                {
                    "si": "Drapet setter i gang en kjedereaksjon. Det ene landet etter det andre går inn i krigen."
                },
                {
                    "si": "Den britiske utenriksministeren Edward Grey sa: Lyset slukkes over hele Europa. Vi vil ikke se det tennes igjen i vår levetid."
                }
            ]
        },
        {
            "id": "fronter",
            "lyd": "vind",
            "kapittel": "Krigen",
            "visual": {
                "type": "OversiktKart",
                "props": {
                    "modus": "fronter"
                }
            },
            "replikker": [
                {
                    "si": "Tyske soldater rykket fram mot Paris. Men høsten 1914 ble de stoppet utenfor byen."
                },
                {
                    "si": "Da gravde begge sider seg ned i lange grøfter, som kalles skyttergraver. De gikk fra grensa til Sveits helt opp til Nordsjøen."
                },
                {
                    "si": "Her sto krigen nesten stille. Slagene ved Verdun og Somme i 1916 ble symboler på en meningsløs sløsing med menneskeliv."
                },
                {
                    "si": "I øst var fronten mye lengre. Der kjempet Russland mot Tyskland og Østerrike-Ungarn over enorme områder."
                },
                {
                    "si": "Det ble også kjempet høyt oppe i Alpene, i Midtøsten og i koloniene i Afrika."
                },
                {
                    "si": "Og på havet prøvde Tyskland å sulte ut Storbritannia med ubåter."
                }
            ]
        },
